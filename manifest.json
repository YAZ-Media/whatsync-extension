{
  "manifest_version": 3,
  "name": "WhatSync — WhatsApp to HubSpot Sync",
  "version": "1.4.0",
  "description": "Sync WhatsApp Web conversations with HubSpot: view contacts, log chats as WhatsApp messages, and create tickets, tasks, and deals.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "storage",
    "alarms",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://web.whatsapp.com/*",
    "https://whatsync.io/*",
    "https://www.whatsync.io/*",
    "https://ogsvchujqpayuckxuwdf.supabase.co/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["config.js", "content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://whatsync.io/*", "https://www.whatsync.io/*"],
      "js": ["dashboard-bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["supabase.js"],
      "matches": ["https://web.whatsapp.com/*"]
    }
  ]
}
